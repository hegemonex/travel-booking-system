<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.travel.booking.mybatis.mapper.PaymentMapper">

    <insert id="create" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payments (
        paymentMethod,
        amount,
        successful,
        paymentDate,
        createdAt
        )
        VALUES (
        #{paymentMethod},
        #{amount},
        #{successful},
        #{paymentDate},
        #{createdAt}
        )
    </insert>

    <select id="findById" resultType="com.travel.booking.model.Payment">
        SELECT * FROM payments WHERE id = #{id}
    </select>

</mapper>